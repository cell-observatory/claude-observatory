{
  "name": "claude-observatory-vscode",
  "displayName": "Claude Observatory",
  "description": "A running list of every file change Claude Code makes, each with its own Keep / Undo (surgical, git-free) — built for established and mission-critical codebases.",
  "version": "0.9.0",
  "publisher": "cell-observatory",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeObservatory",
          "title": "Claude Edits",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "claudeObservatoryDock",
          "title": "Claude Observatory",
          "icon": "media/icon.svg"
        },
        {
          "id": "claudeObservatoryPrompts",
          "title": "Claude Observatory Prompts",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeObservatory": [
        {
          "id": "claudeObservatory.edits",
          "name": "Edits",
          "icon": "media/icon.svg"
        },
        {
          "id": "claudeObservatory.diffs",
          "name": "Diffs",
          "icon": "media/diff.svg"
        },
        {
          "id": "claudeObservatory.fileHistory",
          "name": "File History",
          "icon": "media/history.svg"
        },
        {
          "id": "claudeObservatory.actions",
          "name": "Actions",
          "icon": "media/icon.svg"
        },
        {
          "id": "claudeObservatory.observations",
          "name": "Observations",
          "icon": "media/icon.svg"
        }
      ],
      "claudeObservatoryDock": [
        {
          "id": "claudeObservatory.changemap",
          "name": "Overview",
          "type": "webview",
          "initialSize": 8
        },
        {
          "id": "claudeObservatory.stats",
          "name": "Stats",
          "type": "webview",
          "initialSize": 2
        }
      ],
      "claudeObservatoryPrompts": [
        {
          "id": "claudeObservatory.prompts",
          "name": "Claude Observatory Prompts",
          "type": "webview",
          "initialSize": 2
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeObservatory.edits",
        "when": "!claudeObservatory.hooksInstalled",
        "contents": "No tracked Claude edits in this workspace yet.\nInstall the capture hooks, then let Claude edit a file.\n[Show setup instructions](command:claudeObservatory.setup)\n[Try the demo — no Claude session needed](command:claudeObservatory.startDemo)"
      },
      {
        "view": "claudeObservatory.edits",
        "when": "claudeObservatory.hooksInstalled && claudeObservatory.priorSessionWithEdits",
        "contents": "No edits in this session yet — the hooks are working.\n[Switch to previous session](command:claudeObservatory.switchToPreviousSession)\n[Pick a session…](command:claudeObservatory.switchSession)\n[Try the demo — no Claude session needed](command:claudeObservatory.startDemo)"
      },
      {
        "view": "claudeObservatory.edits",
        "when": "claudeObservatory.hooksInstalled && !claudeObservatory.priorSessionWithEdits",
        "contents": "No edits in this session yet.\nLet Claude edit a file and it will appear here.\n[Try the demo — no Claude session needed](command:claudeObservatory.startDemo)"
      },
      {
        "view": "claudeObservatory.diffs",
        "when": "!claudeObservatory.hooksInstalled",
        "contents": "No tracked Claude edits in this workspace yet.\n[Try the demo — no Claude session needed](command:claudeObservatory.startDemo)"
      },
      {
        "view": "claudeObservatory.diffs",
        "when": "claudeObservatory.hooksInstalled",
        "contents": "No edits in this session yet.\n[Try the demo — no Claude session needed](command:claudeObservatory.startDemo)"
      },
      {
        "view": "claudeObservatory.fileHistory",
        "contents": "Open a file Claude has edited to see its edit history here."
      },
      {
        "view": "claudeObservatory.observations",
        "when": "!claudeObservatory.hooksInstalled",
        "contents": "No tracked Claude edits in this workspace yet.\n[Try the demo — no Claude session needed](command:claudeObservatory.startDemo)"
      },
      {
        "view": "claudeObservatory.observations",
        "when": "claudeObservatory.hooksInstalled",
        "contents": "No edits in this session yet.\n[Try the demo — no Claude session needed](command:claudeObservatory.startDemo)"
      },
      {
        "view": "claudeObservatory.actions",
        "contents": "No tool calls in this session yet.\nEdits, commands, reads, searches, egress, and to-dos appear here as Claude works."
      }
    ],
