{
  "name": "claude-observatory-vscode",
  "displayName": "Claude Observatory",
  "description": "A running list of every file change Claude Code makes, each with its own Keep / Undo (surgical, git-free) — built for established and mission-critical codebases.",
  "version": "0.9.4",
  "publisher": "cell-observatory",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeObservatory",
          "title": "Observatory Traces",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "claudeObservatoryDock",
          "title": "Observatory Dashboards",
          "icon": "media/icon.svg"
        },
        {
          "id": "claudeObservatoryPrompts",
          "title": "Observatory Timeline",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeObservatory": [
        {
          "id": "claudeObservatory.reviewList",
          "name": "Review",
          "type": "webview",
          "icon": "media/review.svg"
        },
        {
          "id": "claudeObservatory.fileHistory",
          "name": "File History",
          "icon": "media/history.svg"
        }
      ],
      "claudeObservatoryDock": [
        {
          "id": "claudeObservatory.changemap",
          "name": "Overview",
          "type": "webview",
          "initialSize": 8
        },
        {
          "id": "claudeObservatory.stats",
          "name": "Stats",
          "type": "webview",
          "initialSize": 2
        }
      ],
      "claudeObservatoryPrompts": [
        {
          "id": "claudeObservatory.timeline",
          "name": "Observatory Timeline",
          "type": "webview",
          "initialSize": 2
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeObservatory.fileHistory",
        "when": "!claudeObservatory.hooksInstalled",
        "contents": "No tracked Claude edits in this workspace yet.\nInstall the capture hooks, then let Claude edit a file.\n[Show setup instructions](command:claudeObservatory.setup)\n[Try the demo — no Claude session needed](command:claudeObservatory.startDemo)"
      },
      {
        "view": "claudeObservatory.fileHistory",
        "when": "claudeObservatory.hooksInstalled",
        "contents": "Open a file Claude has edited to see its edit history here. The Review view above lists every change awaiting a decision.\n[Try the demo — no Claude session needed](command:claudeObservatory.startDemo)"
      }
    ],
    "commands": [
