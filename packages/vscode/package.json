{
  "name": "claude-observatory-vscode",
  "displayName": "Claude Observatory",
  "description": "A running list of every file change Claude Code makes, each with its own Keep / Undo (surgical, git-free).",
  "version": "0.6.0",
  "publisher": "claude-observatory",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeObservatory",
          "title": "Claude Observatory",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "claudeObservatoryPanel",
          "title": "Claude Observatory",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeObservatory": [
        {
          "id": "claudeObservatory.edits",
          "name": "Edits",
          "icon": "media/icon.svg"
        },
        {
          "id": "claudeObservatory.diffs",
          "name": "Diffs",
          "icon": "media/diff.svg"
        },
        {
          "id": "claudeObservatory.fileHistory",
          "name": "File History",
          "icon": "media/history.svg"
        }
      ],
      "claudeObservatoryPanel": [
        {
          "id": "claudeObservatory.observations",
          "name": "Observations",
          "icon": "media/icon.svg"
        },
        {
          "id": "claudeObservatory.timeline",
          "name": "Timeline",
          "icon": "media/icon.svg"
        },
        {
          "id": "claudeObservatory.actions",
          "name": "Actions",
          "icon": "$(list-tree)"
        },
        {
          "id": "claudeObservatory.stats",
          "name": "Stats",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeObservatory.edits",
        "contents": "No tracked Claude edits in this workspace yet.\nInstall the capture hooks, then let Claude edit a file.\n[Show setup instructions](command:claudeObservatory.setup)"
      },
      {
        "view": "claudeObservatory.diffs",
        "contents": "No tracked Claude edits in this workspace yet."
      },
      {
        "view": "claudeObservatory.fileHistory",
        "contents": "Open a file Claude has edited to see its edit history here."
      },
      {
        "view": "claudeObservatory.timeline",
        "contents": "No tracked Claude edits in this workspace yet."
      },
      {
        "view": "claudeObservatory.actions",
        "contents": "No actions yet — this fills in once Claude runs tools in this workspace's session."
      },
      {
        "view": "claudeObservatory.observations",
        "contents": "No tracked Claude edits in this workspace yet."
      }
    ],
    "commands": [
      {
        "command": "claudeObservatory.refresh",
        "title": "Refresh",
        "category": "Claude Observatory",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeObservatory.actionsShowAll",
        "title": "Show all actions (incl. reads/searches)",
        "category": "Claude Observatory",
        "icon": "$(eye)"
      },
      {
        "command": "claudeObservatory.actionsShowCurated",
        "title": "Show curated actions only",
        "category": "Claude Observatory",
        "icon": "$(eye-closed)"
      },
      {
        "command": "claudeObservatory.openDiff",
        "title": "Open Diff",
        "category": "Claude Observatory"
      },
      {
        "command": "claudeObservatory.openFileAtEdit",
        "title": "Open File at Edit",
        "category": "Claude Observatory"
      },
      {
        "command": "claudeObservatory.openFile",
        "title": "Open File",
        "category": "Claude Observatory",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeObservatory.keep",
        "title": "Keep",
        "category": "Claude Observatory",
        "icon": "$(check)"
      },
      {
        "command": "claudeObservatory.undo",
        "title": "Undo",
        "category": "Claude Observatory",
        "icon": "$(discard)"
      },
      {
        "command": "claudeObservatory.redo",
        "title": "Redo",
        "category": "Claude Observatory",
        "icon": "$(redo)"
      },
      {
        "command": "claudeObservatory.keepFile",
        "title": "Keep all edits in file",
        "category": "Claude Observatory",
        "icon": "$(check)"
      },
      {
        "command": "claudeObservatory.undoFile",
        "title": "Undo all edits in file",
        "category": "Claude Observatory",
        "icon": "$(close)"
      },
      {
        "command": "claudeObservatory.keepOpenFile",
        "title": "Accept all edits in this file",
        "category": "Claude Observatory",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeObservatory.undoOpenFile",
        "title": "Revert all edits in this file",
        "category": "Claude Observatory",
        "icon": "$(close-all)"
      },
      {
        "command": "claudeObservatory.setup",
        "title": "Show setup instructions",
        "category": "Claude Observatory"
      },
      {
        "command": "claudeObservatory.installHooks",
        "title": "Install capture hooks",
        "category": "Claude Observatory"
      },
      {
        "command": "claudeObservatory.inlineDiff",
        "title": "Show Claude edit diff",
        "category": "Claude Observatory"
      },
      {
        "command": "claudeObservatory.viewChanges",
        "title": "View changes (inline review)",
        "category": "Claude Observatory"
      },
      {
        "command": "claudeObservatory.peekKeep",
        "title": "Accept this edit",
        "category": "Claude Observatory",
        "icon": "$(check)"
      },
      {
        "command": "claudeObservatory.peekUndo",
        "title": "Revert this edit",
        "category": "Claude Observatory",
        "icon": "$(discard)"
      },
      {
        "command": "claudeObservatory.peekChat",
        "title": "Chat about this edit",
        "category": "Claude Observatory",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claudeObservatory.peekPrev",
        "title": "Previous edit in this file",
        "category": "Claude Observatory",
        "icon": "$(arrow-up)"
      },
      {
        "command": "claudeObservatory.peekNext",
        "title": "Next edit in this file",
        "category": "Claude Observatory",
        "icon": "$(arrow-down)"
      },
      {
        "command": "claudeObservatory.peekPrevFile",
        "title": "Previous changed file",
        "category": "Claude Observatory",
        "icon": "$(arrow-left)"
      },
      {
        "command": "claudeObservatory.peekNextFile",
        "title": "Next changed file",
        "category": "Claude Observatory",
        "icon": "$(arrow-right)"
      },
      {
        "command": "claudeObservatory.peekAcceptFile",
        "title": "Accept file (all pending edits)",
        "category": "Claude Observatory",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeObservatory.peekRejectFile",
        "title": "Reject file (revert all pending edits)",
        "category": "Claude Observatory",
        "icon": "$(close-all)"
      },
      {
        "command": "claudeObservatory.inlineKeep",
        "title": "Keep Claude edit",
        "category": "Claude Observatory"
      },
      {
        "command": "claudeObservatory.inlineUndo",
        "title": "Undo Claude edit",
        "category": "Claude Observatory"
      },
      {
        "command": "claudeObservatory.diffKeep",
        "title": "Keep this edit",
        "category": "Claude Observatory",
        "icon": "$(check)"
      },
      {
        "command": "claudeObservatory.diffUndo",
        "title": "Undo this edit",
        "category": "Claude Observatory",
        "icon": "$(discard)"
      },
      {
        "command": "claudeObservatory.diffChat",
        "title": "Chat about this edit",
        "category": "Claude Observatory",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claudeObservatory.diffPrevEdit",
        "title": "Previous edit in this file",
        "category": "Claude Observatory",
        "icon": "$(arrow-up)"
      },
      {
        "command": "claudeObservatory.diffNextEdit",
        "title": "Next edit in this file",
        "category": "Claude Observatory",
        "icon": "$(arrow-down)"
      },
      {
        "command": "claudeObservatory.toggleInline",
        "title": "Toggle inline review overlay",
        "category": "Claude Observatory",
        "icon": "$(eye)"
      },
      {
        "command": "claudeObservatory.toggleHeatmap",
        "title": "Toggle file heatmap (dim unmodified lines)",
        "category": "Claude Observatory",
        "icon": "$(lightbulb)"
      },
      {
        "command": "claudeObservatory.switchSession",
        "title": "Switch session",
        "category": "Claude Observatory",
        "icon": "$(versions)"
      },
      {
        "command": "claudeObservatory.keepAll",
        "title": "Accept all edits",
        "category": "Claude Observatory",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeObservatory.undoAll",
        "title": "Revert all edits",
        "category": "Claude Observatory",
        "icon": "$(discard)"
      },
      {
        "command": "claudeObservatory.clearResolved",
        "title": "Clear resolved edits",
        "category": "Claude Observatory",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeObservatory.cleanStore",
        "title": "Clean store (reclaim disk / drop session)",
        "category": "Claude Observatory",
        "icon": "$(database)"
      },
      {
        "command": "claudeObservatory.chatEdit",
        "title": "Chat about this edit",
        "category": "Claude Observatory",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claudeObservatory.showObservation",
        "title": "Show observation",
        "category": "Claude Observatory"
      },
      {
        "command": "claudeObservatory.showSuggestions",
        "title": "Show suggestions",
        "category": "Claude Observatory"
      },
      {
        "command": "claudeObservatory.analyzeEdit",
        "title": "Analyze edit with Claude",
        "category": "Claude Observatory",
        "icon": "$(sparkle)"
      },
      {
        "command": "claudeObservatory.refreshRecap",
        "title": "Refresh session recap",
        "category": "Claude Observatory",
        "icon": "$(sparkle)"
      },
      {
        "command": "claudeObservatory.reviewPrev",
        "title": "Review previous pending edit",
        "category": "Claude Observatory",
        "icon": "$(debug-step-back)"
      },
      {
        "command": "claudeObservatory.reviewNext",
        "title": "Review next pending edit",
        "category": "Claude Observatory",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "claudeObservatory.navDiffPrev",
        "title": "Nav bar: previous edit in this file",
        "category": "Claude Observatory",
        "icon": "$(chevron-up)"
      },
      {
        "command": "claudeObservatory.navDiffNext",
        "title": "Nav bar: next edit in this file",
        "category": "Claude Observatory",
        "icon": "$(chevron-down)"
      },
      {
        "command": "claudeObservatory.navFilePrev",
        "title": "Nav bar: previous changed file",
        "category": "Claude Observatory",
        "icon": "$(chevron-left)"
      },
      {
        "command": "claudeObservatory.navFileNext",
        "title": "Nav bar: next changed file",
        "category": "Claude Observatory",
        "icon": "$(chevron-right)"
      },
      {
        "command": "claudeObservatory.navViewDiff",
        "title": "Nav bar: view current edit diff",
        "category": "Claude Observatory",
        "icon": "$(diff)"
      },
      {
        "command": "claudeObservatory.navKeep",
        "title": "Nav bar: keep this edit",
        "category": "Claude Observatory",
        "icon": "$(check)"
      },
      {
        "command": "claudeObservatory.navUndo",
        "title": "Nav bar: undo this edit",
        "category": "Claude Observatory",
        "icon": "$(discard)"
      },
      {
        "command": "claudeObservatory.diffPrevRevision",
        "title": "Diff previous revision of this file",
        "category": "Claude Observatory",
        "icon": "$(git-compare)"
      },
      {
        "command": "claudeObservatory.diffNextRevision",
        "title": "Diff next revision of this file",
        "category": "Claude Observatory",
        "icon": "$(git-compare)"
      },
      {
        "command": "claudeObservatory.searchEdits",
        "title": "Search edits",
        "category": "Claude Observatory",
        "icon": "$(search)"
      },
      {
        "command": "claudeObservatory.exportSummary",
        "title": "Export review summary",
        "category": "Claude Observatory",
        "icon": "$(export)"
      },
      {
        "command": "claudeObservatory.doctor",
        "title": "Setup check (doctor)",
        "category": "Claude Observatory",
        "icon": "$(pulse)"
      },
      {
        "command": "claudeObservatory.keepAtCursor",
        "title": "Keep pending edit at cursor",
        "category": "Claude Observatory"
      },
      {
        "command": "claudeObservatory.undoAtCursor",
        "title": "Undo pending edit at cursor",
        "category": "Claude Observatory"
      },
      {
        "command": "claudeObservatory.checkForUpdates",
        "title": "Check for updates",
        "category": "Claude Observatory",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeObservatory.clearFile",
        "title": "Clear resolved edits in file",
        "category": "Claude Observatory",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeObservatory.keepFolder",
        "title": "Accept all edits in folder",
        "category": "Claude Observatory",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeObservatory.undoFolder",
        "title": "Revert all edits in folder",
        "category": "Claude Observatory",
        "icon": "$(discard)"
      },
      {
        "command": "claudeObservatory.clearFolder",
        "title": "Clear resolved edits in folder",
        "category": "Claude Observatory",
        "icon": "$(clear-all)"
      }
    ],
    "keybindings": [
      {
        "command": "claudeObservatory.reviewNext",
        "key": "ctrl+alt+n",
        "mac": "alt+cmd+n"
      },
      {
        "command": "claudeObservatory.reviewPrev",
        "key": "ctrl+alt+p",
        "mac": "alt+cmd+p"
      },
      {
        "command": "claudeObservatory.keepAtCursor",
        "key": "ctrl+alt+y",
        "mac": "alt+cmd+y",
        "when": "editorTextFocus"
      },
      {
        "command": "claudeObservatory.undoAtCursor",
        "key": "ctrl+alt+u",
        "mac": "alt+cmd+u",
        "when": "editorTextFocus"
      },
      {
        "command": "claudeObservatory.keepOpenFile",
        "key": "ctrl+alt+k",
        "mac": "alt+cmd+k",
        "when": "editorTextFocus"
      },
      {
        "command": "claudeObservatory.undoOpenFile",
        "key": "ctrl+alt+r",
        "mac": "alt+cmd+r",
        "when": "editorTextFocus"
      },
      {
        "command": "claudeObservatory.diffPrevRevision",
        "key": "ctrl+alt+[",
        "mac": "alt+cmd+[",
        "when": "editorTextFocus"
      },
      {
        "command": "claudeObservatory.diffNextRevision",
        "key": "ctrl+alt+]",
        "mac": "alt+cmd+]",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "comments/commentThread/title": [
        {
          "command": "claudeObservatory.peekPrev",
          "when": "commentController == claudeObservatory && commentThread == claudeEdit",
          "group": "inline@1"
        },
        {
          "command": "claudeObservatory.peekNext",
          "when": "commentController == claudeObservatory && commentThread == claudeEdit",
          "group": "inline@2"
        },
        {
          "command": "claudeObservatory.peekPrevFile",
          "when": "commentController == claudeObservatory && commentThread == claudeEdit",
          "group": "inline@3"
        },
        {
          "command": "claudeObservatory.peekNextFile",
          "when": "commentController == claudeObservatory && commentThread == claudeEdit",
          "group": "inline@4"
        },
        {
          "command": "claudeObservatory.peekKeep",
          "when": "commentController == claudeObservatory && commentThread == claudeEdit",
          "group": "inline@5"
        },
        {
          "command": "claudeObservatory.peekUndo",
          "when": "commentController == claudeObservatory && commentThread == claudeEdit",
          "group": "inline@6"
        },
        {
          "command": "claudeObservatory.peekAcceptFile",
          "when": "commentController == claudeObservatory && commentThread == claudeEdit",
          "group": "inline@7"
        },
        {
          "command": "claudeObservatory.peekRejectFile",
          "when": "commentController == claudeObservatory && commentThread == claudeEdit",
          "group": "inline@8"
        },
        {
          "command": "claudeObservatory.peekChat",
          "when": "commentController == claudeObservatory && commentThread == claudeEdit",
          "group": "inline@9"
        }
      ],
      "view/title": [
        {
          "command": "claudeObservatory.searchEdits",
          "when": "view == claudeObservatory.edits || view == claudeObservatory.diffs",
          "group": "navigation@1"
        },
        {
          "command": "claudeObservatory.reviewPrev",
          "when": "view == claudeObservatory.edits",
          "group": "navigation@2"
        },
        {
          "command": "claudeObservatory.reviewNext",
          "when": "view == claudeObservatory.edits",
          "group": "navigation@3"
        },
        {
          "command": "claudeObservatory.keepAll",
          "when": "view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline",
          "group": "navigation@4"
        },
        {
          "command": "claudeObservatory.undoAll",
          "when": "view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline",
          "group": "navigation@5"
        },
        {
          "command": "claudeObservatory.keepOpenFile",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs) && claudeObservatory.activeFileHasPending",
          "group": "navigation@6"
        },
        {
          "command": "claudeObservatory.undoOpenFile",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs) && claudeObservatory.activeFileHasPending",
          "group": "navigation@7"
        },
        {
          "command": "claudeObservatory.clearResolved",
          "when": "view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline || view == claudeObservatory.observations",
          "group": "navigation@8"
        },
        {
          "command": "claudeObservatory.switchSession",
          "when": "view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline || view == claudeObservatory.observations",
          "group": "navigation@9"
        },
        {
          "command": "claudeObservatory.cleanStore",
          "when": "view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline || view == claudeObservatory.observations",
          "group": "navigation@10"
        },
        {
          "command": "claudeObservatory.refresh",
          "when": "view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline || view == claudeObservatory.observations",
          "group": "navigation@10"
        },
        {
          "command": "claudeObservatory.actionsShowAll",
          "when": "view == claudeObservatory.actions && !claudeObservatory.actionsShowAll",
          "group": "navigation@1"
        },
        {
          "command": "claudeObservatory.actionsShowCurated",
          "when": "view == claudeObservatory.actions && claudeObservatory.actionsShowAll",
          "group": "navigation@1"
        },
        {
          "command": "claudeObservatory.refresh",
          "when": "view == claudeObservatory.actions",
          "group": "navigation@2"
        },
        {
          "command": "claudeObservatory.toggleInline",
          "when": "view == claudeObservatory.edits",
          "group": "navigation@11"
        },
        {
          "command": "claudeObservatory.exportSummary",
          "when": "view == claudeObservatory.edits || view == claudeObservatory.diffs",
          "group": "1_export"
        },
        {
          "command": "claudeObservatory.doctor",
          "when": "view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.observations",
          "group": "1_export"
        },
        {
          "command": "claudeObservatory.refreshRecap",
          "when": "view == claudeObservatory.observations",
          "group": "navigation@0"
        },
        {
          "command": "claudeObservatory.diffPrevRevision",
          "when": "view == claudeObservatory.fileHistory",
          "group": "navigation@1"
        },
        {
          "command": "claudeObservatory.diffNextRevision",
          "when": "view == claudeObservatory.fileHistory",
          "group": "navigation@2"
        },
        {
          "command": "claudeObservatory.keepOpenFile",
          "when": "view == claudeObservatory.fileHistory && claudeObservatory.activeFileHasPending",
          "group": "navigation@3"
        },
        {
          "command": "claudeObservatory.undoOpenFile",
          "when": "view == claudeObservatory.fileHistory && claudeObservatory.activeFileHasPending",
          "group": "navigation@4"
        },
        {
          "command": "claudeObservatory.refresh",
          "when": "view == claudeObservatory.fileHistory",
          "group": "navigation@5"
        }
      ],
      "editor/title": [
        {
          "command": "claudeObservatory.navDiffPrev",
          "when": "claudeObservatory.activeFileHasPending",
          "group": "navigation@1"
        },
        {
          "command": "claudeObservatory.navDiffNext",
          "when": "claudeObservatory.activeFileHasPending",
          "group": "navigation@2"
        },
        {
          "command": "claudeObservatory.navFilePrev",
          "when": "claudeObservatory.activeFileHasPending",
          "group": "navigation@3"
        },
        {
          "command": "claudeObservatory.navFileNext",
          "when": "claudeObservatory.activeFileHasPending",
          "group": "navigation@4"
        },
        {
          "command": "claudeObservatory.navKeep",
          "when": "claudeObservatory.activeFileHasPending",
          "group": "navigation@5"
        },
        {
          "command": "claudeObservatory.navUndo",
          "when": "claudeObservatory.activeFileHasPending",
          "group": "navigation@6"
        },
        {
          "command": "claudeObservatory.keepOpenFile",
          "when": "claudeObservatory.activeFileHasPending",
          "group": "navigation@7"
        },
        {
          "command": "claudeObservatory.undoOpenFile",
          "when": "claudeObservatory.activeFileHasPending",
          "group": "navigation@8"
        },
        {
          "command": "claudeObservatory.clearResolved",
          "when": "claudeObservatory.activeFileHasPending",
          "group": "navigation@9"
        },
        {
          "command": "claudeObservatory.toggleHeatmap",
          "when": "claudeObservatory.activeFileHasPending",
          "group": "navigation@10"
        },
        {
          "command": "claudeObservatory.searchEdits",
          "when": "claudeObservatory.activeFileHasPending",
          "group": "navigation@11"
        },
        {
          "command": "claudeObservatory.diffKeep",
          "when": "isInDiffEditor && resourceScheme == claude-edit",
          "group": "navigation@1"
        },
        {
          "command": "claudeObservatory.diffUndo",
          "when": "isInDiffEditor && resourceScheme == claude-edit",
          "group": "navigation@2"
        },
        {
          "command": "claudeObservatory.diffChat",
          "when": "isInDiffEditor && resourceScheme == claude-edit",
          "group": "navigation@3"
        },
        {
          "command": "claudeObservatory.diffPrevEdit",
          "when": "isInDiffEditor && resourceScheme == claude-edit",
          "group": "navigation@4"
        },
        {
          "command": "claudeObservatory.diffNextEdit",
          "when": "isInDiffEditor && resourceScheme == claude-edit",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeObservatory.refreshRecap",
          "when": "view == claudeObservatory.observations && viewItem == recap",
          "group": "inline@0"
        },
        {
          "command": "claudeObservatory.analyzeEdit",
          "when": "view == claudeObservatory.observations && viewItem == observation",
          "group": "inline@0"
        },
        {
          "command": "claudeObservatory.chatEdit",
          "when": "view == claudeObservatory.observations && viewItem == observation",
          "group": "navigation@1"
        },
        {
          "command": "claudeObservatory.keep",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline || view == claudeObservatory.fileHistory) && viewItem == edit",
          "group": "inline@1"
        },
        {
          "command": "claudeObservatory.undo",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline || view == claudeObservatory.fileHistory) && viewItem == edit",
          "group": "inline@2"
        },
        {
          "command": "claudeObservatory.openFile",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline || view == claudeObservatory.fileHistory) && viewItem == edit",
          "group": "navigation@1"
        },
        {
          "command": "claudeObservatory.redo",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline || view == claudeObservatory.fileHistory) && viewItem == editUndone",
          "group": "inline@1"
        },
        {
          "command": "claudeObservatory.openFile",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline || view == claudeObservatory.fileHistory) && viewItem == editUndone",
          "group": "navigation@1"
        },
        {
          "command": "claudeObservatory.openFile",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline) && viewItem == file",
          "group": "inline@0"
        },
        {
          "command": "claudeObservatory.keepFile",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline) && viewItem == file",
          "group": "inline@1"
        },
        {
          "command": "claudeObservatory.undoFile",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline) && viewItem == file",
          "group": "inline@2"
        },
        {
          "command": "claudeObservatory.clearFile",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline) && viewItem == file",
          "group": "inline@3"
        },
        {
          "command": "claudeObservatory.keepFolder",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs) && viewItem == folder",
          "group": "inline@1"
        },
        {
          "command": "claudeObservatory.undoFolder",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs) && viewItem == folder",
          "group": "inline@2"
        },
        {
          "command": "claudeObservatory.clearFolder",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs) && viewItem == folder",
          "group": "inline@3"
        },
        {
          "command": "claudeObservatory.chatEdit",
          "when": "(view == claudeObservatory.edits || view == claudeObservatory.diffs || view == claudeObservatory.timeline || view == claudeObservatory.fileHistory) && (viewItem == edit || viewItem == editUndone)",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Claude Observatory",
      "properties": {
        "claudeObservatory.inlineReview": {
          "type": "boolean",
          "default": true,
          "description": "Show Claude's pending edits inline in the editor (gutter change-bars + a per-edit ✨ marker with Keep/Undo/Diff/Chat on hover)."
        },
        "claudeObservatory.inlineDiffView": {
          "type": "boolean",
          "default": true,
          "description": "Open a Claude edit's before ⟷ after diff in the unified (inline) view — the red/green single-column look — instead of side-by-side. Best-effort: flips a freshly opened diff via VS Code's built-in inline toggle when your editor defaults to side-by-side."
        },
        "claudeObservatory.claudeBin": {
          "type": "string",
          "default": "",
          "description": "Path to the `claude` CLI used for opt-in 'Analyze'/'Generate suggestions' (leave empty to auto-detect on PATH / common locations)."
        },
        "claudeObservatory.session": {
          "type": "string",
          "default": "",
          "description": "Pin which capture session the observatory shows (a session id, e.g. `demo-showcase`). Leave empty to auto-resolve the newest session for the workspace. Use the 'Switch session' button to change it."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "build": "npm run typecheck && npm run bundle",
    "package": "vsce package --no-dependencies -o claude-observatory.vsix"
  },
